# Database: SQLAlchemy with the psycopg driver.
# For raw SQL, use the connection format required by your PostgreSQL driver.
DATABASE_URL=databaseurl

# JWT: replace the placeholder with a random secret before running.
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Billing: use one currency consistently throughout the application.
DELIVERY_FEE=40.00

# Email: assumes a local SMTP test server listening on port 1025.
# Set credentials and TLS to match your SMTP provider when using one.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=orders@example.com
